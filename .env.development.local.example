# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibarratravel

# .NET API Configuration
ASPNETCORE_ENVIRONMENT=Development
# OBLIGATORIO, mínimo 64 caracteres aleatorios. Generar con: openssl rand -base64 48
# NUNCA uses una clave pública o commiteada.
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES_0123456789
EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_MINUTES=10080
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN_MINUTES=43200
COOKIE_SECURE=false
