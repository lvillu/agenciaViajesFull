# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibarratravel

# API Configuration
ASPNETCORE_ENVIRONMENT=Development

# Secret Key para JWT (OBLIGATORIO, mínimo 64 caracteres aleatorios).
# Generar con: openssl rand -base64 48
# (PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 })))
# NUNCA uses el valor de ejemplo anterior ni lo subas a git.
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES_0123456789

# Token Configuration
EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_MINUTES=10080
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN_MINUTES=43200
COOKIE_SECURE=false
