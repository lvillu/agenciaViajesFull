# ============================================================
# .env.prod.example — Plantilla de variables de producción
# Copia este archivo como .env en la instancia EC2:
#   cp .env.prod.example .env
# Luego edita .env con los valores reales. NUNCA subas .env a git.
# ============================================================

# ---- AWS RDS PostgreSQL (db.t3.micro free tier) ----
# Endpoint que asigna RDS, ej: mydb.xxxxxx.us-east-1.rds.amazonaws.com
RDS_HOST=mydb.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CambiaEstoPorUnaPasswordSegura123!
POSTGRES_DB=ibarratravel

# ---- JWT / Seguridad ----
# Mínimo 32 caracteres aleatorios
SECRET_KEY=GeneraUnaClaveSecretaMuyLargaYAleatoriaAqui!

# Expiración del access token en minutos (30 min recomendado en prod)
EXPIRES_IN_MINUTES=30

# Expiración del refresh token en minutos (1440 = 1 día)
REFRESH_TOKEN_EXPIRES_IN_MINUTES=1440

# ---- URLs públicas de la instancia EC2 ----
# IP pública de la instancia o dominio (se recomienda Elastic IP o Route 53)
# Ejemplos con IP:   http://54.123.45.67
# Ejemplos con dominio: https://tudominio.com

# URL del frontend (lo que ve el usuario en el browser)
# frontend estará en el puerto 3000
CORS_ALLOWED_ORIGIN=http://54.123.45.67:3000

# Orígenes permitidos en el backend (.NET) — puede ser igual que CORS_ALLOWED_ORIGIN
CORS_ALLOWED_ORIGINS=http://54.123.45.67:3000

# URL de KrakenD tal como la ve el BROWSER (no el servidor).
# KrakenD corre en el puerto 5050.
NEXT_PUBLIC_API_URL=http://54.123.45.67:5050
