{
  "version": 3,
  "name": "Agencia Viajes API Gateway",
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/signup",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/signup",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/logout",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/logout",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/api/v1/users/me",
      "method": "GET",
      "output_encoding": "json",
      "cache_ttl": "60s",
      "backend": [
        {
          "url_pattern": "/api/v1/users/me",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false
        }
      ]
    }
  ]
}
