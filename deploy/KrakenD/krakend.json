{
  "version": 3,
  "name": "Agencia Viajes API Gateway",
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:3000",
        "http://localhost:3001"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type",
        "Accept"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/login",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/Auth/login",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "encoding": "no-op",
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/signup",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/Auth/signup",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "encoding": "no-op",
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/logout",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/api/Auth/logout",
          "host": ["http://api:8080"],
          "disable_host_sanitize": false,
          "encoding": "no-op",
          "method": "POST"
        }
      ]
    },
    {
      "endpoint": "/User/me",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Authorization", "Content-Type" ],
      "backend": [
        {
          "url_pattern": "/api/User/me",
          "host": ["http://api:8080"],
          "method": "GET"
        }
      ]
    }
  ]
}
